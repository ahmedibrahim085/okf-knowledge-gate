# okflint house profile — the starter for <bundle>/okf-base.yaml.
# `okf-check --init-house-rules <bundle>` writes it for you (and never overwrites). Edit it to taste.
#
# This is the HOUSE layer. It answers "is this valid OUR OKF?" — required fields
# per type, controlled vocabularies, hygiene levels. The SPEC layer ("is this
# valid OKF at all?") is the vendored okf_validate.py and needs no config.
#
# Values below are the ones verified against ~/.claude/lessons on 2026-07-30:
# they caught 2 real errors (a status outside vocabulary, and a missing log.md)
# and both RED probes fired.

okf_version: "0.2"

base:
  name: CHANGE ME
  roots:
    - path: .
  reserved_files:
    index: index.md
    log: log.md

profile:
  types:
    Lesson:
      # stale_after is REQUIRED here on purpose: an undated lesson cannot rot
      # visibly, and invisible rot is the failure this whole gate exists to stop.
      required: [type, title, description, stale_after]
      optional: [status, tags, generated, verified, sources]
      status_values: [draft, stable, deprecated]
    Lesson Family:
      required: [type, title, description, stale_after]
      optional: [status, tags, generated, verified]
      status_values: [draft, stable, deprecated]
    Reference:
      required: [type, title]
      optional: [status, tags, generated, stale_after]

hygiene:
  broken_links: warn      # OKF §6.1 requires consumers to TOLERATE broken links
  split_candidates: warn  # S202 fires on ~90% of prose-heavy bundles — advisory only
  reserved_files: error
  unknown_fields: off     # OKF explicitly allows producer-defined keys

# okf-check's own options. Every option is off until you set it. To turn one on, remove the "# " in front of its
# line (and of the `okf_check:` line above it). A key okf-check does not know, or a value of the wrong shape, stops
# the run (exit 2) and names the key. okflint ignores this block. Values below are examples: set your own.
#
# okf_check:
#   edit_hook: true             # check each note Claude writes or edits in this bundle (L1 and Trust, one line per finding)
#   graph: true                 # run the optional okf-memory layer: orphan notes and broken concept links (advisory)
#   max_note_bytes: 5242880     # a note above this many bytes is refused and the run exits 1 (default 5242880)
#   wikilink_root: ..           # the folder wikilinks like [[projects/p/README]] start from, relative to the bundle
#   deprecated_requires: superseded_by   # every `status: deprecated` note names its replacement in `superseded_by`
#   require_owner: true         # every note has an owner (its own `owner` key, else the folder defaults in `owners`)
#   owners:                     # folder defaults for the owner, as globs; the last matching pattern wins
#     "decisions/**": team:architecture
#   size:                       # a body-size budget per note, in characters
#     max_body_chars: 40000     # above this: a house-rule error (exit 1)
#     warn_body_chars: 38000    # above this: a warning (must be below max_body_chars)
#     exclude: ["generated/**"] # notes a script writes, left out of this rule
#   facts:                      # a fact stated in many notes; a note with another value is a FACT-CONFLICT (exit 1)
#     launch.countries:
#       value: "A and B"
#       patterns: ["launch countries?:? *(.+)"]   # group 1 is the stated value
#       source: decisions/0007.md                 # the note where the value is decided
#   duplicates:                 # for `okf-check <bundle> --duplicates`
#     threshold: 1.0            # description word overlap that counts as a duplicate (1.0 = identical word sets)
#     body_threshold: 0.6       # body similarity for --duplicates-body
#     time_limit: 60            # seconds before the report stops and says CUT SHORT
#   verify:                     # read by okf-verify
#     repos:                    # repositories that the cited commit ids are looked up in
#       - path: ..              # relative to the bundle, absolute, or ~/...
#     generated: ["registers/**"]   # notes a script regenerates: a line citation into one needs an anchor
#     remote: true              # ask the GitHub or GitLab API for a commit no searched clone holds
