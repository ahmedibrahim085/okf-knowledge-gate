#!/usr/bin/env python3
# /// script
# requires-python = ">=3.9"
# ///
"""okf-export — an Obsidian-style vault folder in, a conformant OKF bundle out.

Note tools count only `[[wikilinks]]` for backlinks and graphs, so a team that edits in one cannot
switch its source to OKF links without losing those features. This command lets the vault stay the
single source: it writes a separate bundle that okf-check can gate. The vault is only read.

Usage:
    okf-export <vault> <out>
"""
from __future__ import annotations

import argparse
import bisect
import datetime
import functools
import os
import re
import shutil
import sys
import tempfile
import unicodedata
from pathlib import Path
from urllib.parse import quote

VENDOR = Path(__file__).resolve().parent.parent / "vendor"
# The pinned copies go FIRST: a yaml module inherited from the environment must not outrank the pin
# (plugin/vendor/VENDOR.md, "The vendored copy wins, on purpose").
sys.dont_write_bytecode = True   # an import must not leave scripts/__pycache__ in the installed plugin (plugin.test.sh Z-2)
sys.path[:0] = [str(VENDOR / "pyyaml"), str(VENDOR), str(Path(__file__).resolve().parent)]
import yaml  # noqa: E402
from okf_validate import OKF_VERSION, load_frontmatter, split_frontmatter  # noqa: E402  (the validator's own reader, so both agree)
from okf_guard import read_note, refusal  # noqa: E402  (a note is opened only when regular and within the cap)

# `[[target#heading|alias]]`. An embed `![[x]]` transcludes x, which a Markdown link cannot say, so it is left as written.
WIKILINK = re.compile(r"(?<!!)\[\[([^\[\]]+)\]\]")

# CommonMark: a fence opens with 3+ backticks or tildes, up to 3 spaces in, and closes on a run of the
# same character at least as long. An ATX heading is 1-6 '#' and a space; closing '#'s are not text.
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
ATX = re.compile(r"^ {0,3}#{1,6}[ \t]+(.*?)(?:[ \t]+#+)?[ \t]*$")
# An indented code block is 4 spaces or a tab in; it cannot interrupt a paragraph.
INDENTED = re.compile(r"^(?: {4}| {0,3}\t)")
LIST_ITEM = re.compile(r"^ {0,3}(?:[-*+]|\d{1,9}[.)])(?:[ \t]|$)")
# A list item's content starts after the marker and 1-4 spaces; with none, or 5 and more (code in the item), one column
# after the marker. A line after a blank line belongs to the item only if it is indented at least that far (CommonMark
# 0.31.2, 5.2 List items). Tabs count to the next stop of 4 columns (2.2 Tabs).
ITEM_CONTENT = re.compile(r"^( {0,3}(?:[-*+]|\d{1,9}[.)]))( *)(.?)")


# The same two patterns matched at an offset into a line (re.match(text, pos)): a marker line is read by walking it once.
LIST_AT = re.compile(LIST_ITEM.pattern[1:])
ITEM_AT = re.compile(ITEM_CONTENT.pattern[1:])


def break_tail(text: str):
    """(start, char): a thematic break can only be a line's tail made of one of - * _ and spaces; this is where that run
    starts, so a check from any later offset costs no scan of the line again."""
    tail = text.rstrip(" \t")
    ch = tail[-1:]
    j = len(tail)
    if ch and ch in "-*_":
        while j and tail[j - 1] in (ch, " ", "\t"):
            j -= 1
    return j, ch


def break_at(text: str, pos: int, tail) -> bool:
    """THEMATIC.match(text[pos:]) without the slice: up to 3 spaces, then 3 or more of one break character and spaces."""
    j, ch = tail
    if pos < j or not ch or ch not in "-*_":
        return False
    q = pos
    while q < len(text) and text[q] == " " and q - pos < 4:
        q += 1
    return q - pos <= 3 and text[q:q + 1] == ch and text.count(ch, q) >= 3


def indent_width(line: str) -> int:
    wide = line.expandtabs(4)
    return len(wide) - len(wide.lstrip(" "))
# A code span closes on a backtick run of exactly its opening length.
# SHORTCUT: one line only; a span wrapped across lines is read as text. Track spans per paragraph if one shows up.
CODE_SPAN = re.compile(r"(?<!`)(`+)(?!`).+?(?<!`)\1(?!`)")
# A problem line quotes link text and file names from the vault, and a person or Claude reads it: control characters
# become "?" (the edit hook's set, 0.9.13 review).
CONTROL = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029]")
# A setext heading: the paragraph above is the heading text, underlined with = (level 1) or - (level 2).
SETEXT = re.compile(r"^ {0,3}(?:=+|-+)[ \t]*$")
# A thematic break: three or more of one of - * _ (spaces between allowed). Under a paragraph a - line is a setext underline.
THEMATIC = re.compile(r"^ {0,3}([-*_])(?:[ \t]*\1){2,}[ \t]*$")


def split_lines(text: str) -> list[str]:
    """The lines as an editor counts them, line ends kept: \n, \r\n or a lone \r ends a line (str.splitlines also splits
    at \f, \x1c and \u2028, which moved every later line number of the report; 0.9.14 re-verify)."""
    return re.findall(r"[^\r\n]*(?:\r\n|\n|\r)|[^\r\n]+$", text)


def plugin_version() -> str:
    """The plugin's version, from .claude-plugin/plugin.json (the one place bump-version.sh moves for this tool)."""
    import json
    try:
        return json.loads((Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json").read_text(encoding="utf-8"))["version"]
    except (OSError, ValueError, KeyError):
        return "unknown"


def fold(name: str) -> str:
    """A name compared without case: NFC, then lower() (okf_guard._fold, the rule okf-check uses)."""
    return unicodedata.normalize("NFC", name).lower()


def slug(heading: str) -> str:
    """The anchor GitHub gives a heading: lower case, punctuation dropped, each space a '-'."""
    return re.sub(r"[^\w\- ]", "", unicodedata.normalize("NFC", heading).strip().lower()).replace(" ", "-")


def frontmatter_len(lines: list[str]) -> int:
    """Lines taken by the YAML block at the top (spec 4: '---' on its own line, then a closing '---'); 0 if none."""
    if lines and lines[0].lstrip("\ufeff").strip() == "---":   # a byte order mark is not part of the fence line
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                return i + 1
    return 0


def dedent(line: str, cols: int) -> str:
    """The line with up to `cols` columns of leading space taken off: its text as the list item it sits in sees it."""
    wide = line.expandtabs(4)
    return wide[min(cols, indent_width(line)):]


# HTML block starts (CommonMark 0.31.2, 4.6), each with the line that ends it; None: a blank line ends it. The last kind,
# a lone complete tag, cannot interrupt a paragraph.
HTML_TAGS = ("address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|"
             "dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|"
             "legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|search|section|summary|table|"
             "tbody|td|tfoot|th|thead|title|tr|track|ul")
HTML_BLOCKS = [
    (re.compile(r"^ {0,3}<(?:script|pre|style|textarea)(?:[ \t>]|$)", re.I), re.compile(r"</(?:script|pre|style|textarea)>", re.I)),
    (re.compile(r"^ {0,3}<!--"), re.compile(r"-->")),
    (re.compile(r"^ {0,3}<\?"), re.compile(r"\?>")),
    (re.compile(r"^ {0,3}<![A-Za-z]"), re.compile(r">")),
    (re.compile(r"^ {0,3}<!\[CDATA\["), re.compile(r"\]\]>")),
    (re.compile(rf"^ {{0,3}}</?(?:{HTML_TAGS})(?:[ \t>]|/>|$)", re.I), None),
]
HTML_TAG_LINE = re.compile(r"^ {0,3}(?:<[A-Za-z][A-Za-z0-9-]*(?:\s+[A-Za-z_:][\w.:-]*(?:\s*=\s*(?:[^\s\"'=<>`]+|'[^']*'|\"[^\"]*\"))?)*"
                           r"\s*/?>|</[A-Za-z][A-Za-z0-9-]*\s*>)\s*$")
# A block quote marker (5.1): up to 3 spaces, then '>'.
QUOTE = re.compile(r"^ {0,3}>")
# A link reference definition (4.7) on one line: it is no paragraph and cannot interrupt one.
LINK_DEF = re.compile(r"^ {0,3}\[(?:[^\]\\]|\\.)+\]:")


# Block quotes inside list items inside block quotes ... are read by nested calls of body_lines: one level per call. Past
# this depth the note is named and copied unchanged (Python's own limit would end the run with a traceback near 500).
NEST_MAX = 100


class TooDeep(Exception):
    """A note whose block quotes and list items nest deeper than NEST_MAX."""


def quote_depth(text: str):
    """(content, depth): a block quote line's text after its '>' markers, and how many there were."""
    m = re.match(r"(?: {0,3}>[ \t]?)+", text)
    return (text[m.end():], m.group(0).count(">")) if m else (text, 0)


def quote_block(lines: list[str], start: int, first: str, at: int):
    """(line indexes, contents) of the block quote that starts at `start` with the quote line `first` (its text, markers
    included): the lines that carry a '>' (read against the item content at `at`) with one '>' taken off, and the lazy
    lines that continue a paragraph (5.1). body_lines reads the contents, so a quote in this quote is read by a nested call.
    `para` errs towards True: a line taken in that CommonMark leaves outside can only hide a heading (a loud 'missing
    heading'), never add one.
    SHORTCUT: setext headings inside block quotes are not recognised (body_lines with nested=True); a link to one fails
    with 'missing heading'."""
    def starts_block(t):
        return ATX.match(t) or FENCE.match(t) or THEMATIC.match(t) or any(h[0].match(t) for h in HTML_BLOCKS)

    idx, contents = [], []
    para, fence = False, 0   # a paragraph may be open; the quote level of an open fence (0: none)
    j, text = start, first
    while True:
        if j > start:
            if j >= len(lines):
                break
            line = lines[j].rstrip("\r\n")
            if not line.strip():
                break   # a blank line ends the quote
            text = dedent(line, at)
        inner, depth = quote_depth(text)
        if not depth:   # lazy: only under a paragraph, and not a line that starts a block of its own
            if fence or not para or LIST_ITEM.match(text) or starts_block(text):
                break
        elif fence and depth >= fence:   # in the fence: its content keeps any deeper '>'
            para = False
            if FENCE.match(re.sub(r"^(?: {0,3}>[ \t]?){%d}" % fence, "", text)):
                fence = 0
        else:   # a lower level ends a deeper fence (its quote ends), so the line is read afresh
            fence = depth if FENCE.match(inner) else 0
            para = not fence and bool(inner.strip()) and not starts_block(inner)
        idx.append(j)
        contents.append(re.sub(r"^ {0,3}>[ \t]?", "", text, count=1))
        j += 1
    return idx, contents


def body_lines(lines: list[str], nested: bool = False, level: int = 0):
    """Yield (index, line, in_code, heading) for each body line. in_code is True inside a fence, fence lines included,
    and on the lines of an indented code block; heading is the text of a heading that ends on this line (ATX, or the
    underline of a setext heading), else None. Blocks are read the way CommonMark 0.31.2 reads them, inside list items
    too (5.2): each line is matched against the content of the item it sits in, a marker line's own content included.
    A blank line is never code: it holds no link, and the log reader counts it.

    A block quote (5.1) is read as a container too: its lines, '>' taken off, are read by this same reader (nested=True),
    inside a list item as well, and quotes nest. SHORTCUT: a lazy line continues a quote's paragraph by a line test on
    the quote's last line, not by the inner reader's state; read it from the inner reader if a note shows a difference.
    Inside a quote (nested) no setext heading is read: see quote_block."""
    items = []             # content indents of the open list items, outer first
    empty = False          # the innermost item has no content yet: a blank line ends it
    para = []              # the lines of the open paragraph, as its item sees them (setext heading text)
    fence, fence_at = "", 0   # the open fence and the content indent it sits at
    html, html_at = False, 0  # an open HTML block: its end pattern (None: a blank line), the content indent
    code = False           # inside an indented code block
    quoted = {}            # results for the lines of a block quote read ahead: index -> (in_code, heading)
    for i in range(0 if nested else frontmatter_len(lines), len(lines)):
        raw = lines[i]
        if i in quoted:
            yield (i, raw) + quoted.pop(i)
            continue
        line = raw.rstrip("\r\n")   # matched without its line end: `$` in SETEXT and THEMATIC must see a CRLF line too
        w = indent_width(line)
        if (fence or html is not False) and line.strip() and w < (fence_at if fence else html_at):
            fence, html = "", False   # the item ends and its fence or HTML block with it
        if fence:
            m = FENCE.match(dedent(line, fence_at))
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                fence = ""
            yield i, raw, True, None
            continue
        if html is not False:
            if html is None and not line.strip():
                html = False   # a blank line ends it; the blank line is read below
            else:
                if html is not None and html.search(line):
                    html = False
                yield i, raw, False, None
                continue
        if not line.strip():
            if empty:
                items.pop()
            empty, para = False, []
            yield i, raw, False, None
            continue
        depth = bisect.bisect_right(items, w)   # the items this line's indent keeps it inside (items only grow)
        text = dedent(line, items[depth - 1] if depth else 0)
        if para and depth == len(items) and SETEXT.match(text) and not nested:   # not in a quote: see quote_block
            heading = " ".join(x.strip() for x in para)
            para = []
            yield i, raw, False, heading
            continue
        brk = THEMATIC.match(text)
        item = LIST_ITEM.match(text) and not brk   # `- - -` is a thematic break, not an item
        starts = [h for h in HTML_BLOCKS if h[0].match(text)]
        interrupts = item or brk or FENCE.match(text) or ATX.match(text) or starts or QUOTE.match(text)
        if para and not interrupts:
            para.append(text)   # a paragraph goes on, lazily too: at the margin under an item's paragraph
            yield i, raw, False, None
            continue
        del items[depth:]   # the line is outside the deeper items: they end
        empty, para = False, []
        if code and not INDENTED.match(text):
            code = False
        at = items[-1] if items else 0
        pos, tail = 0, item and break_tail(text)   # text has no tabs: dedent expanded them
        while item:   # a marker line: open the item, then read its own content as the item's first line
            g = ITEM_AT.match(text, pos)
            marker, spaces, rest = len(g.group(1)), len(g.group(2)), g.group(3)
            width = marker + spaces if rest and 1 <= spaces <= 4 else marker + 1   # the content indent (ITEM_CONTENT)
            pos += width
            at = (items[-1] if items else 0) + width
            items.append(at)
            if not rest:
                empty = True
                break
            item = LIST_AT.match(text, pos) and not break_at(text, pos, tail)
        text = text[pos:]   # one slice per line: the cost stays linear in its length
        if not empty and QUOTE.match(text):   # a block quote: read its lines with this reader, then go on after it
            if level >= NEST_MAX:   # `level` counts nested reads; `depth` below is the list-item depth of one line
                raise TooDeep()
            idx, contents = quote_block(lines, i, text, at)
            for k, _, c, h in body_lines(contents, nested=True, level=level + 1):
                quoted[idx[k]] = (c, h)
            para, code = [], False
            yield (i, raw) + quoted.pop(i)
            continue
        heading, in_code = None, False
        starts = [h for h in HTML_BLOCKS if h[0].match(text)]   # again: a marker line's content may start one
        m = ATX.match(text)
        f = FENCE.match(text)
        if empty:
            pass
        elif code or INDENTED.match(text):
            code = in_code = True
        elif m:
            heading = m.group(1)
        elif f:
            fence, fence_at, in_code = f.group(1), at, True
        elif THEMATIC.match(text) or LINK_DEF.match(text):
            pass
        elif starts or HTML_TAG_LINE.match(text):
            end = starts[0][1] if starts else None
            html, html_at = (False if end is not None and end.search(text[text.index("<") + 1:]) else end), at
        else:
            para = [text]
        yield i, raw, in_code, heading


def read_text(path: Path) -> str:
    """The note as written: no newline translation (a CRLF note stays CRLF), a BOM kept. Raises UnicodeDecodeError.

    Bounded: main() leaves a refused note out of `files`, and this refuses one that changed after that."""
    return read_note(path, "utf-8", "strict", newline="")


@functools.lru_cache(maxsize=None)   # one read per target, however many links point at it
def heading_slugs(path: Path) -> set[str]:
    try:
        lines = [l.rstrip("\r\n") for l in split_lines(read_text(path).lstrip("\ufeff"))]   # a BOM is not part of the first heading line
    except UnicodeDecodeError:
        return set()   # the target is reported on its own as not valid UTF-8; a heading in it cannot be found
    found, counts = set(), {}
    try:
        for _, _, _, h in body_lines(lines):
            if h is None:
                continue
            # github-slugger: a repeated anchor gets the next number whose anchor is free (Foo, Foo-1, Foo: foo, foo-1, foo-2)
            base = anchor = slug(h)
            n = counts.get(base, 0)
            while anchor in found:
                n += 1
                anchor = f"{base}-{n}"
            counts[base] = n
            found.add(anchor)
    except TooDeep:
        pass   # the note is named on its own (main); its headings past the cap are not known
    return found


# Spec 9 log input, read from a vault log.md: a level-2 heading (`## 2026-05-22`) whose lines are that day's entries,
# or a dated list item (`- 2026-05-22: text`). Every `## ` heading must be an ISO date, as the validator's check_log
# requires; headings of level 3-6 are entry text. DATEISH also catches near-misses (2026/05/22, 2026-5-2), and an item
# date is the whole token up to a space or ':' (2026-05-221, 2026-05-01-extra), so a bad date is reported, never split.
DATEISH = r"\d{4}[-/.]\d{1,2}[-/.]\d{1,2}"
LEVEL2 = re.compile(r"^##[ \t]+(.*?)[ \t]*$")
DATED_ITEM = re.compile(rf"^[ \t]*[-*+][ \t]+({DATEISH}[^\s:]*)[ \t]*:?[ \t]*(.*)$")
TITLE = re.compile(r"^#[ \t]+(.*?)[ \t]*$")


def iso_day(text: str) -> str | None:
    """Spec 9: date headings MUST use ISO 8601 YYYY-MM-DD; it must also be a real day."""
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
        return None
    try:
        return datetime.date.fromisoformat(text).isoformat()
    except ValueError:
        return None


def is_log(rel: Path) -> bool:
    """Spec 3.1 reserves log.md; compared case-folded, as a case-insensitive disk (macOS APFS, Windows) compares it (X-18)."""
    return rel.name.casefold() == "log.md"


def vault_out_rel(rel: Path, root_name: str) -> Path:
    """Spec 3.1: index.md is reserved and MUST NOT be a concept, so a vault's index.md note becomes the
    folder note dir/<dir>.md (the vault root's takes the vault folder's name). The folder is kept."""
    if rel.name.casefold() == "index.md":   # casefold: on a case-insensitive disk Index.md IS index.md
        return rel.parent / f"{rel.parent.name or root_name}.md"
    if is_log(rel):
        return rel.parent / "log.md"   # spec 3.1 names it in lower case; a case-sensitive disk tells Log.md apart
    return rel


def shared_outputs(files: list[Path], root_name: str) -> list[tuple[Path, Path, Path]]:
    """(first, second, output) for each output path that two or more renamed inputs would be written to:
    Index.md and index.md in one folder both become <folder>.md. Only renamed files are compared: a renamed file
    against a note that already has that name is the clash check in main(), and a.md next to A.md stay two files."""
    groups: dict[Path, list[Path]] = {}
    for rel in files:
        if vault_out_rel(rel, root_name) != rel:
            groups.setdefault(vault_out_rel(rel, root_name), []).append(rel)
    return [(g[0], g[1], out) for out, g in groups.items() if len(g) > 1]


def case_clashes(files: list[Path], root_name: str) -> list[tuple[Path, Path]]:
    """(first, second) for each two output names in one folder that differ only in case, named by their vault paths:
    a disk that folds case (macOS, Windows) writes both to one file or folder. Two names in different folders
    clash at the folders, so a pair is reported once, where it starts."""
    names: dict[Path, Path] = {}   # output name -> vault path; a folder keeps its name
    for rel in files:
        out = vault_out_rel(rel, root_name)
        names[out] = rel
        for d in out.parents:
            if d != Path("."):
                names.setdefault(d, d)
    first: dict[tuple[Path, str], Path] = {}
    pairs = []
    for out in sorted(names):
        key = (out.parent, out.name.casefold())
        if key in first:
            pairs.append((names[first[key]], names[out]))
        else:
            first[key] = out
    return pairs


def case_insensitive(folder: Path) -> bool:
    """Whether the disk that holds folder (or will: an output not made yet goes in its nearest existing parent) folds
    case. A temp folder is made there and removed, so nothing is left behind. Raises OSError if it cannot be written."""
    while not folder.exists():
        folder = folder.parent
    probe = Path(tempfile.mkdtemp(prefix=".okf-case-", dir=folder))
    try:
        (probe / "a").touch()
        return (probe / "A").exists()
    finally:
        shutil.rmtree(probe)


def build_log(rel: Path, lines: list[str], problems: list[str]) -> str | None:
    """A spec 9 log from a vault log.md's dated lines: date groups, newest first, no frontmatter, the vault log's own
    `# Title` kept (else `# Log`). Whatever cannot go into the log goes to `problems`, so nothing is dropped silently:
    frontmatter, a bad date, a `## ` heading that is not a date (with the count of lines left out under it), a line
    under no date, a log with no dated entry (then None: no log is written)."""
    lines = [lines[0].lstrip("\ufeff"), *lines[1:]] if lines else lines   # a BOM is not part of the title line (X-17)
    name = rel.as_posix()
    if frontmatter_len(lines):
        problems.append(f"{name}:1: frontmatter dropped, a spec log has none")
    groups: dict[str, list[str]] = {}
    current: str | None = None     # the day of the last ## heading; "" under a rejected heading
    item_day: str | None = None    # the day of the last dated item, which an indented line continues; "" if rejected
    title: str | None = None
    blank = False                  # a blank line since the last kept line: one is kept between two lines of a day
    rejected: list | None = None   # [index in problems, lines left out] of the rejected heading being read

    def close_rejected() -> None:
        if rejected:
            n = rejected[1]
            problems[rejected[0]] += f" ({n} line{'' if n == 1 else 's'} under it left out)"

    def keep(day: str, text: str) -> None:
        nonlocal blank
        group = groups.setdefault(day, [])
        if blank and group:
            group.append("")
        group.append(CONTROL.sub("?", text))   # the log is read by people and agents (X-20)
        blank = False

    for i, line, code, _ in body_lines(lines):
        text, where = line.rstrip("\r\n"), f"{name}:{i + 1}"
        if not code:
            if not text.strip():
                blank = True
                continue
            heading = LEVEL2.match(text)
            if heading:
                close_rejected()
                rejected, item_day, blank = None, None, False
                current = iso_day(heading.group(1)) or ""
                if not current:
                    problems.append(f"{where}: heading {heading.group(1)} is not an ISO YYYY-MM-DD date")
                    rejected = [len(problems) - 1, 0]
                continue
            item = DATED_ITEM.match(text)
            if item:
                item_day = iso_day(item.group(1)) or ""
                if item_day:
                    keep(item_day, f"* {item.group(2)}")
                else:
                    problems.append(f"{where}: date {item.group(1)} is not an ISO YYYY-MM-DD day")
                continue
            if title is None and current is None and item_day is None and TITLE.match(text):
                title = TITLE.match(text).group(1)   # the vault log's own title, which a [[#Title]] link may name
                continue
        if item_day is not None and text[:1] in (" ", "\t"):
            if item_day:
                keep(item_day, text)   # an indented line continues the dated item above it (item 3)
            continue
        item_day = None
        if current is None:
            problems.append(f"{where}: line belongs to no date: {text.strip()}")
        elif current:
            keep(current, text)
        else:
            rejected[1] += 1
    close_rejected()
    days = sorted(groups, reverse=True)
    if not days:
        problems.append(f"{name}:1: no dated entry, no log written")
        return None
    head = f"# {CONTROL.sub('?', title) if title else 'Log'}\n"
    return head + "".join(f"\n## {d}\n" + "".join(f"{e}\n" for e in groups[d]) for d in days)


def link_text(text: str) -> str:
    """Text for the inside of [...] in an index line: one line, no control characters, brackets and backslashes escaped
    (a title is a YAML block scalar or a free string from the vault; 0.9.15 review)."""
    text = CONTROL.sub("?", " ".join(text.split()))
    out, pos = [], 0
    for span in CODE_SPAN.finditer(text):   # inside a code span a backslash is literal (CommonMark 6.1): no escapes there
        out += [re.sub(r"([\\\[\]])", r"\\\1", text[pos:span.start()]), span.group(0)]
        pos = span.end()
    return "".join(out) + re.sub(r"([\\\[\]])", r"\\\1", text[pos:])


def entry(path: Path) -> str:
    """One spec 8 index line: `* [title](file) - description`, the title falling back to the file name."""
    try:   # a BOM is not part of the frontmatter fence; a note that is not UTF-8 was copied as it is (X-11)
        raw, _ = split_frontmatter(read_text(path).lstrip("\ufeff"))
    except UnicodeDecodeError:
        raw = None
    try:
        meta = load_frontmatter(raw) if raw is not None else {}
    except (yaml.YAMLError, ValueError):   # okf-check reports the bad frontmatter; the index still lists the file
        meta = {}
    meta = meta if isinstance(meta, dict) else {}
    title = meta.get("title") if isinstance(meta.get("title"), str) else path.stem
    desc = CONTROL.sub("?", " ".join(meta["description"].split())) if isinstance(meta.get("description"), str) else ""
    return f"* [{link_text(title)}]({quote(path.name)})" + (f" - {desc}" if desc else "") + "\n"


def write_indexes(out: Path, concepts: list[Path]) -> None:
    """Spec 8: an index.md in every folder that holds a concept, directly or below. No frontmatter, except the
    root's okf_version (spec 8, 12). A Concepts section, then a Folders section; an empty one is left out."""
    folders: dict[Path, tuple[list[Path], set[str]]] = {}
    for c in concepts:
        folders.setdefault(c.parent, ([], set()))[0].append(c)
        d = c.parent
        while d != Path("."):
            folders.setdefault(d.parent, ([], set()))[1].add(d.name)
            d = d.parent
    for d, (names, subs) in folders.items():
        sections = []
        if names:
            sections.append("# Concepts\n\n" + "".join(entry(out / c) for c in sorted(names)))
        if subs:
            sections.append("# Folders\n\n" + "".join(f"* [{link_text(s)}]({quote(s)}/)\n" for s in sorted(subs)))
        head = f'---\nokf_version: "{OKF_VERSION}"\n---\n' if d == Path(".") else ""
        (out / d / "index.md").write_text(head + "\n".join(sections), encoding="utf-8")


def fail(msg: str) -> int:
    print(f"okf-export: {CONTROL.sub('?', msg)}", file=sys.stderr)   # it can name vault files (X-10)
    return 2


def main() -> int:
    ap = argparse.ArgumentParser(description="Export an Obsidian-style vault folder to an OKF bundle.")
    ap.add_argument("--version", action="version", version=f"okf-export {plugin_version()}")
    ap.add_argument("vault", type=Path)
    ap.add_argument("out", type=Path)
    args = ap.parse_args()
    vault, out = args.vault.resolve(), args.out.resolve()
    # Exit 2 before anything is written: the vault is only read, and <out> is never merged into.
    if not vault.is_dir():
        return fail(f"{args.vault} is not a folder")
    if out == vault or vault in out.parents:
        return fail(f"{args.out} is inside the vault {args.vault}; choose a folder outside it")
    if out.exists() and not out.is_dir():
        return fail(f"{args.out} exists and is not a folder")
    if out.exists() and any(out.iterdir()):
        return fail(f"{args.out} exists and is not empty")
    # Dot files and folders hold note-tool settings (.obsidian), VCS data (.git) or OS clutter (.DS_Store), not knowledge.
    files = sorted(rel for rel in (p.relative_to(vault) for p in vault.rglob("*") if p.is_file())
                   if not any(part.startswith(".") for part in rel.parts))
    # A *.md that is not a regular file (device, pipe, folder) or is over okf_check.max_note_bytes is not exported and is
    # never opened; it is reported with the other problems. rglob("*") would list an oversize note, so it goes here.
    refused = sorted((rel, why) for rel, why in ((p.relative_to(vault), refusal(p)) for p in vault.rglob("*.md")) if why
                     and not any(part.startswith(".") for part in rel.parts))
    # A symlink inside the vault that leads outside it would copy text from elsewhere into the bundle: it is left out and
    # named by its name and link text (never the host path it resolves to). One that stays inside the vault is exported as
    # before. rglob does not enter a symlinked folder (Python 3.9 and 3.12 measured), so only a file symlink gets here.
    refused += sorted((rel, f"a symlink to {os.readlink(vault / rel)}, which leads outside the vault" if (vault / rel).is_symlink()
                       else "a file under a symlinked folder that leads outside the vault") for rel in files
                      if not (vault / rel).resolve().is_relative_to(vault))
    skip = {rel for rel, _ in refused}
    files = [rel for rel in files if rel not in skip]
    fileset = set(files)
    by_name: dict[str, list[Path]] = {}
    by_name_ci: dict[str, list[Path]] = {}
    by_path_ci: dict[str, list[Path]] = {}
    for p in files:
        by_name.setdefault(p.name, []).append(p)
        by_name_ci.setdefault(fold(p.name), []).append(p)   # NFC + lower(), as Obsidian: casefold() would match ß to ss
        by_path_ci.setdefault(fold(p.as_posix()), []).append(p)

    def resolve(name: str) -> list[Path]:
        """Obsidian's rule: a target with '/' is a vault-root path, a bare name is a file name anywhere
        in the vault. Either may leave out '.md'. An exact match wins; otherwise case is ignored, as Obsidian
        ignores it, and two files that differ only in case are both returned (ambiguous). The case-insensitive step also
        reads both names in Unicode NFC (macOS may store café decomposed), as okf_guard.obsidian_path does for okf-check."""
        if "/" in name:
            exact = [p for p in (Path(name), Path(name + ".md")) if p in fileset][:1]
            return exact or by_path_ci.get(fold(name)) or by_path_ci.get(fold(name + ".md")) or []
        return (by_name.get(name) or by_name.get(name + ".md")
                or by_name_ci.get(fold(name)) or by_name_ci.get(fold(name + ".md")) or [])

    out_rel = functools.partial(vault_out_rel, root_name=vault.name)

    # S10-E2: a rename onto an existing note would overwrite it. Stop before anything is written.
    # Names are compared case-folded, the way a case-insensitive disk (macOS APFS, Windows) compares them.
    folded = {p.as_posix().casefold() for p in files}
    clashes = [(rel, out_rel(rel)) for rel in files if rel.name.casefold() == "index.md" and out_rel(rel).as_posix().casefold() in folded]
    # The same for the log (X-19): log.md and Log.md can share a folder only on a case-sensitive disk; both become log.md.
    clashes += [(rel, out_rel(rel)) for rel in files if is_log(rel) and rel != out_rel(rel)
                and any(p != rel and p.as_posix().casefold() == out_rel(rel).as_posix().casefold() for p in files)]
    for rel, new in clashes:
        if new == rel:
            fail(f"{rel.as_posix()} is the folder note of a folder named index, which leaves it no other name; rename the folder in the vault")
        else:
            fail(f"{rel.as_posix()} would be renamed to {new.as_posix()}, which already exists; rename one of them in the vault")
    # Two renamed inputs that share one output name would overwrite each other: Index.md and index.md.
    shared = shared_outputs(files, vault.name)
    for first, second, new in shared:
        fail(f"{first.as_posix()} and {second.as_posix()} would both be written to {new.as_posix()}; rename one of them in the vault")
    if clashes or shared:
        return 2
    # A case-sensitive vault may hold Notes.md and notes.md, which a case-folding output disk (macOS, Windows) writes
    # to one file. Only there do names that differ only in case clash, so the disk is probed only for such a
    # pair: an ordinary export makes nothing in or beside <out> for the probe.
    base = out
    while not base.exists():
        base = base.parent
    if not os.access(base, os.W_OK | os.X_OK):
        return fail(f"cannot write to {args.out}: Permission denied")
    try:
        folded_pairs = case_clashes(files, vault.name)
        folded_pairs = folded_pairs if folded_pairs and case_insensitive(out) else []
    except OSError as err:
        return fail(f"cannot write to {args.out}: {err.strerror}")
    for first, second in folded_pairs:
        fail(f"{first.as_posix()} and {second.as_posix()} would be written over each other: {args.out} is on a disk"
             " that does not tell upper from lower case; rename one of them in the vault")
    if folded_pairs:
        return 2

    problems: list[str] = [f"{rel.as_posix()} — {why}: skipped" for rel, why in refused]
    for rel in files:
        dest = out / out_rel(rel)
        dest.parent.mkdir(parents=True, exist_ok=True)
        if rel.suffix != ".md":
            shutil.copy2(vault / rel, dest)
            continue
        try:
            lines = split_lines(read_text(vault / rel))
        except UnicodeDecodeError:
            problems.append(f"{rel.as_posix()}:1: not valid UTF-8, copied unchanged")
            shutil.copy2(vault / rel, dest)
            continue
        try:
            rows = list(body_lines(lines))
        except TooDeep:
            problems.append(f"{rel.as_posix()}:1: block quotes and list items nested deeper than {NEST_MAX} levels: copied unchanged, its links not rewritten")
            shutil.copy2(vault / rel, dest)
            continue
        for i, line, code, _ in rows:
            if code:
                continue
            no = i + 1

            def link(m: re.Match) -> str:
                ref, _, alias = m.group(1).replace("\\|", "|").partition("|")   # a table cell writes the alias bar as \|
                name, _, heading = ref.partition("#")
                found = resolve(name) if name else [rel]
                if len(found) != 1:
                    what = "ambiguous target" if found else "missing target"
                    names = ", ".join(p.as_posix() for p in found)
                    if len({unicodedata.normalize("NFC", p.as_posix()) for p in found}) < len(found):   # they look alike
                        names = ", ".join(p.as_posix().encode("ascii", "backslashreplace").decode() for p in found) \
                            + " (they differ only in Unicode normalisation)"
                    problems.append(f"{rel.as_posix()}:{no}: {what} {m.group(0)}" + (f": {names}" if names else ""))
                    return m.group(0)
                # Spec 6.1 allows a relative or a bundle-absolute (/...) link; the relative form is what the ticket
                # asks for. Percent-encoded: a CommonMark link destination cannot hold a space.
                href = quote(os.path.relpath(out_rel(found[0]), rel.parent).replace(os.sep, "/")) if name else ""
                if heading and found[0].suffix != ".md":
                    href += "#" + quote(heading, safe="=&")   # a PDF page link: the fragment is the viewer's, not a heading
                elif heading:
                    if slug(heading) not in heading_slugs(vault / found[0]):
                        problems.append(f"{rel.as_posix()}:{no}: missing heading {m.group(0)}")
                        return m.group(0)
                    href += "#" + slug(heading)
                text = alias or (f"{name} > {heading}" if name and heading else name or heading)
                return f"[{text}]({href})"

            parts, pos = [], 0
            for span in CODE_SPAN.finditer(line):
                parts += [WIKILINK.sub(link, line[pos:span.start()]), span.group(0)]
                pos = span.end()
            lines[i] = "".join(parts) + WIKILINK.sub(link, line[pos:])
        if is_log(rel):   # spec 3.1: reserved, so never a concept; it becomes the spec 9 log
            log = build_log(rel, lines, problems)
            if log is not None:
                dest.write_text(log, encoding="utf-8")
            continue
        dest.write_bytes("".join(lines).encode("utf-8"))   # bytes: no newline translation on the way out either
    write_indexes(out, [out_rel(rel) for rel in files if rel.suffix == ".md" and not is_log(rel)])
    for p in problems:
        print(CONTROL.sub("?", p))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
